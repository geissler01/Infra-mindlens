{
  "family": "poc-worker-task",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "016963912697.dkr.ecr.us-east-2.amazonaws.com/poc-worker:latest",
      "essential": true,
      "environment": [
        {"name": "DB_HOST", "value": "journal-db-poc.cxeacy8aglmv.us-east-2.rds.amazonaws.com"},
        {"name": "DB_PASS", "value": "postgres"},
        {"name": "SQS_QUEUE_URL", "value": "https://sqs.us-east-2.amazonaws.com/016963912697/journal-queue"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
            "awslogs-group": "/ecs/poc-worker",
            "awslogs-region": "us-east-2",
            "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::016963912697:role/ecsTaskExecutionRolePoc",
  "taskRoleArn": "arn:aws:iam::016963912697:role/ecsTaskExecutionRolePoc"
}
