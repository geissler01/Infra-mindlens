{
  "family": "poc-backend-task",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "016963912697.dkr.ecr.us-east-2.amazonaws.com/poc-backend:latest",
      "essential": true,
      "portMappings": [{"containerPort": 8080, "hostPort": 8080, "protocol": "tcp"}],
      "environment": [
        {"name": "MASTER_DB_HOST", "value": "journal-db-poc.cxeacy8aglmv.us-east-2.rds.amazonaws.com"},
        {"name": "MASTER_DB_NAME", "value": "master_db"},
        {"name": "MASTER_DB_USER", "value": "postgres"},
        {"name": "TENANT_DB_HOST", "value": "journal-db-poc.cxeacy8aglmv.us-east-2.rds.amazonaws.com"},
        {"name": "TENANT_DB_NAME", "value": "journal_db"},
        {"name": "TENANT_DB_USER", "value": "postgres"},
        {"name": "Jwt__Issuer", "value": "MindLens"},
        {"name": "Jwt__Audience", "value": "MindLensUsers"},
        {"name": "SQS_QUEUE_URL", "value": "https://sqs.us-east-2.amazonaws.com/016963912697/journal-queue"}
      ],
      "secrets": [
        {"name": "ConnectionStrings__SharedDB", "valueFrom": "arn:aws:ssm:us-east-2:016963912697:parameter/mindlens/prod/db_connection_string"},
        {"name": "Jwt__Key", "valueFrom": "arn:aws:ssm:us-east-2:016963912697:parameter/mindlens/prod/jwt_key"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
            "awslogs-group": "/ecs/poc-backend",
            "awslogs-region": "us-east-2",
            "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::016963912697:role/ecsTaskExecutionRolePoc",
  "taskRoleArn": "arn:aws:iam::016963912697:role/ecsTaskExecutionRolePoc"
}
